# 复制为 .env 并填入本机值: cp .env.example .env
# NCS_TOOLCHAIN: NCS SDK 的 toolchains/<hash> 目录 (含 usr/local/bin 与 opt/zephyr-sdk)
NCS_TOOLCHAIN=<ncs-toolchain-path>

export BOARD="${BOARD:-nodara}"
export CROSS_COMPILE="${CROSS_COMPILE:-$NCS_TOOLCHAIN/opt/zephyr-sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-}"
export PYTHONHOME="$NCS_TOOLCHAIN/usr/local"
export PYTHONPATH="$NCS_TOOLCHAIN/usr/local/lib/python3.12:$NCS_TOOLCHAIN/usr/local/lib/python3.12/site-packages"
export PATH="$NCS_TOOLCHAIN/usr/local/bin:$PATH"
